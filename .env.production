# Production overrides — Vite loads this on `npm run build` (mode=production)
# ON TOP of .env, so dev values in .env can never leak into a release bundle.
# Added 2026-10-12 (RELEASE_CHECKLIST Phase 2, task 2.2): a build made from a
# dev checkout baked http://localhost:5000/api/v1 into the app.
#
# Same-origin API: the hosted site serves the SPA and proxies /api, /uploads
# and /socket.io to the backend (see README "Deploy" and vite.config.js proxy
# comments). If the API lives on another host, put its full URL here.
VITE_API_URL=/api/v1

# Marketing site base. Empty = the app's built-in default (https://bestodine.com).
VITE_MARKETING_URL=

# Public origin for QR codes / share links. Empty = the page's own origin.
VITE_PUBLIC_APP_URL=
